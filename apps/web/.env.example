# Public website URL, without a trailing slash
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only API origin used by Next.js rewrites
API_UPSTREAM_URL=http://localhost:4000

# Browser-visible API/WebSocket origin
NEXT_PUBLIC_WS_URL=http://localhost:4000

# Optional static TURN fallback. Normally the API returns short-lived Metered
# credentials and these values can remain blank.
NEXT_PUBLIC_TURN_URL=
NEXT_PUBLIC_TURN_URL_TLS=
NEXT_PUBLIC_TURN_USERNAME=
NEXT_PUBLIC_TURN_CREDENTIAL=
